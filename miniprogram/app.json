{
  "pages": [
    "pages/index/index",
    "pages/learn/learn",
    "pages/share/share",
    "pages/calendar/calendar",
    "pages/dashboard/dashboard",
    "pages/profile/profile"
  ],
  "subPackages": [
    { "root": "audio-pkg-a", "name": "audio-a", "pages": ["_dummy"] },
    { "root": "audio-pkg-b", "name": "audio-b", "pages": ["_dummy"] },
    { "root": "audio-pkg-c", "name": "audio-c", "pages": ["_dummy"] },
    { "root": "audio-pkg-d", "name": "audio-d", "pages": ["_dummy"] }
  ],
  "preloadRule": {
    "pages/index/index": { "network": "all", "packages": ["audio-a"] }
  },
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#FF6B6B",
    "navigationBarTitleText": "暖声·向暖而行",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#F5F5F5"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#FF6B6B",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "images/tab-home.png",
        "selectedIconPath": "images/tab-home-active.png"
      },
      {
        "pagePath": "pages/calendar/calendar",
        "text": "打卡",
        "iconPath": "images/tab-calendar.png",
        "selectedIconPath": "images/tab-calendar-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "images/tab-profile.png",
        "selectedIconPath": "images/tab-profile-active.png"
      }
    ]
  },
  "permission": {
    "scope.record": {
      "desc": "您的录音将用于普通话练习和回听对比"
    }
  },
  "requiredBackgroundModes": ["audio"],
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
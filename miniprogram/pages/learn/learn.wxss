/* 学习页：练习台 */

.learn-page {
  padding-top: 26rpx;
}

.practice-header {
  padding: 0 4rpx 26rpx;
}

.progress-top-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 24rpx;
  margin-bottom: 18rpx;
}

.segment-label {
  display: block;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #202124;
}

.time-display {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #8F472B;
  font-weight: 800;
  padding-bottom: 4rpx;
}

.practice-header .progress-bar-bg {
  height: 22rpx;
  margin-bottom: 14rpx;
}

.progress-bottom-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.segment-desc {
  font-size: 28rpx;
  color: #7D756D;
}

.content-card {
  margin-bottom: 22rpx;
}

.content-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 26rpx;
}

.segment-badge {
  min-height: 52rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #F1E8DD;
  color: #8F472B;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
}

.speed-control {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.speed-label {
  font-size: 28rpx;
  color: #5F5A54;
}

.speed-options {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 22rpx;
  background: #F1E8DD;
}

.speed-btn {
  min-width: 64rpx;
  min-height: 54rpx;
  border-radius: 18rpx;
  color: #5F5A54;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.speed-btn.active {
  background: #B85C38;
  color: #FFFFFF;
}

.sentence-area {
  background: #F7F1EA;
  border: 2rpx solid #ECE1D6;
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 28rpx;
}

.sentence-label {
  display: block;
  font-size: 26rpx;
  color: #7D756D;
  font-weight: 800;
  text-align: center;
  margin-bottom: 12rpx;
}

.sentence-text {
  display: block;
  font-size: 58rpx;
  font-weight: 800;
  color: #202124;
  line-height: 1.35;
  margin-bottom: 18rpx;
  text-align: center;
}

.sentence-pinyin {
  display: block;
  font-size: 36rpx;
  color: #7D756D;
  line-height: 1.5;
  margin-bottom: 22rpx;
  text-align: center;
}

.highlight-box {
  background: #FFFCF8;
  border-left: 8rpx solid #B85C38;
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
}

.highlight-label {
  display: block;
  font-size: 28rpx;
  color: #8F472B;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.highlight-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.55;
  color: #4A4038;
}

.audio-area {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.btn-play {
  min-height: 104rpx;
  background: #B85C38;
  color: #FFFFFF;
  border: none;
  border-radius: 52rpx;
  font-size: 34rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 10rpx 22rpx rgba(184, 92, 56, 0.18);
}

.btn-play::after,
.btn-record::after,
.btn-recording::after,
.btn-listen::after,
.btn-prev::after,
.btn-next::after {
  border: none;
}

.btn-play-icon {
  width: 42rpx;
  font-size: 34rpx;
  text-align: center;
}

.btn-play-text {
  font-size: 34rpx;
}

.record-row {
  display: flex;
  gap: 16rpx;
}

.btn-record,
.btn-recording,
.btn-listen {
  flex: 1;
  min-height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 18rpx 20rpx;
}

.btn-record {
  background: #FFFCF8;
  color: #8F472B;
  border: 3rpx solid #B85C38;
}

.btn-recording {
  background: #B33A2F;
  color: #FFFFFF;
  border: none;
}

.btn-listen {
  background: #F1E8DD;
  color: #4A4038;
  border: 2rpx solid #D9CABA;
}

.btn-record-icon,
.btn-listen-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(184, 92, 56, 0.12);
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: center;
}

.btn-recording .btn-record-icon {
  background: rgba(255, 255, 255, 0.2);
}

.segment-nav {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.nav-btn {
  min-height: 88rpx;
  border-radius: 18rpx;
  background: #FFFCF8;
  color: #5F5A54;
  border: 2rpx solid #ECE1D6;
  font-size: 31rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn.active {
  background: #F1E8DD;
  color: #8F472B;
  border-color: #B85C38;
}

.bottom-actions {
  display: flex;
  gap: 18rpx;
  padding-bottom: 26rpx;
}

.btn-prev,
.btn-next {
  flex: 1;
  min-height: 96rpx;
  border-radius: 48rpx;
  background: #FFFCF8;
  color: #4A4038;
  border: 2rpx solid #D9CABA;
  font-size: 32rpx;
  font-weight: 800;
}

.btn-prev[disabled] {
  color: #B8ADA2;
  background: #F4EEE7;
  border-color: #E8DDD1;
}

.btn-finish {
  flex: 1;
}

<view class="container calendar-page">
  <view class="summary-card card">
    <text class="eyebrow">练习回顾</text>
    <text class="summary-title">{{currentMonth}}</text>
    <view class="summary-stats">
      <view class="stat">
        <text class="stat-num">{{monthStats.completed}}</text>
        <text class="stat-label">已完成</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{monthStats.streak}}</text>
        <text class="stat-label">连续</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{monthStats.total}}</text>
        <text class="stat-label">本月天数</text>
      </view>
    </view>
  </view>

  <view class="calendar-card card">
    <view class="calendar-head">
      <text class="section-title">打卡日历</text>
      <view class="legend">
        <view class="legend-item"><text class="legend-dot done"></text><text>完成</text></view>
        <view class="legend-item"><text class="legend-dot missed"></text><text>未打卡</text></view>
      </view>
    </view>
    <view class="weekdays">
      <text wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</text>
    </view>
    <view class="days-grid">
      <view
        wx:for="{{days}}"
        wx:key="date"
        class="day-cell {{item.empty ? 'empty' : ''}} {{item.status}} {{item.isToday ? 'today' : ''}}"
      >
        <text class="day-num">{{item.day}}</text>
        <text class="day-mark" wx:if="{{item.status === 'done'}}">完成</text>
        <text class="day-mark" wx:if="{{item.status === 'missed'}}">缺</text>
        <text class="today-mark" wx:if="{{item.isToday}}">今</text>
      </view>
    </view>
  </view>

  <view class="today-card card" wx:if="{{todayStatus}}">
    <view class="today-info">
      <view>
        <text class="eyebrow">今日状态</text>
        <text class="today-value {{todayStatus.done ? 'done' : 'pending'}}">
          {{todayStatus.done ? '已完成练习' : '今天还未打卡'}}
        </text>
      </view>
      <text class="today-badge {{todayStatus.done ? 'done' : 'pending'}}">
        {{todayStatus.done ? '完成' : '待练'}}
      </text>
    </view>
    <view class="today-detail" wx:if="{{todayStatus.done}}">
      <text>学习时长：{{todayStatus.minutes}} 分钟</text>
      <text>完成内容：{{todayStatus.segments}} 个段落</text>
    </view>
    <button class="btn-primary" bindtap="goLearn" wx:if="{{!todayStatus.done}}">去完成今天练习</button>
  </view>

  <view class="history-card card">
    <text class="section-title">本月记录</text>
    <view class="history-list">
      <view class="history-item" wx:for="{{historyList}}" wx:key="date">
        <view class="history-left">
          <text class="history-date">{{item.date}}</text>
          <text class="history-weekday">{{item.weekday}}</text>
        </view>
        <view class="history-right">
          <text class="history-status {{item.done ? 'done' : 'missed'}}">
            {{item.done ? '完成' : '未打卡'}}
          </text>
          <text class="history-minutes" wx:if="{{item.done}}">{{item.minutes}} 分钟</text>
        </view>
      </view>
    </view>
  </view>
</view>

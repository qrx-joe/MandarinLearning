/* 日历页 - 长辈友好风格 */

.container {
  padding-bottom: 40rpx;
}

/* 概览 */
.summary-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.summary-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 28rpx;
}

.summary-stats {
  display: flex;
  justify-content: space-around;
}

.stat {
  text-align: center;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #FF6B6B;
  display: block;
}

.stat-label {
  font-size: 28rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

/* 日历 */
.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding-bottom: 20rpx;
  border-bottom: 3rpx solid #F0E6E0;
  margin-bottom: 20rpx;
}

.weekday {
  text-align: center;
  font-size: 30rpx;
  color: #999;
  font-weight: 500;
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
}

.day-cell {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  position: relative;
  padding: 12rpx;
  min-height: 88rpx;
}

.day-cell.empty {
  background: transparent;
}

.day-num {
  font-size: 32rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.day-cell.today {
  border: 4rpx solid #FF6B6B;
  background: #FFF5F5;
}

.day-cell.today .day-num {
  color: #FF6B6B;
  font-weight: 700;
}

.day-cell.done {
  background: #E8F5E9;
}

.day-cell.done .day-num {
  color: #2E7D32;
  font-weight: 700;
}

.day-cell.missed {
  background: #FFEBEE;
}

.day-cell.missed .day-num {
  color: #999;
}

.day-mark {
  font-size: 28rpx;
  margin-top: 4rpx;
}

/* 今日状态 */
.today-card .btn-primary {
  margin-top: 24rpx;
}

.today-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.today-label {
  font-size: 34rpx;
  color: #666;
  font-weight: 500;
}

.today-value {
  font-size: 36rpx;
  font-weight: 700;
}

.today-value.done {
  color: #4CAF50;
}

.today-value.pending {
  color: #FF6B6B;
}

.today-detail {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 30rpx;
  color: #666;
  margin-bottom: 24rpx;
}

/* 历史 */
.history-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  display: block;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F0E6E0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-date {
  font-size: 34rpx;
  color: #1A1A1A;
  font-weight: 500;
  display: block;
}

.history-weekday {
  font-size: 28rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.history-status {
  font-size: 32rpx;
  font-weight: 600;
}

.history-status.done {
  color: #4CAF50;
}

.history-minutes {
  font-size: 28rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 32rpx;
}

/* 打卡页：进度回顾 */

.calendar-page {
  padding-top: 32rpx;
}

.summary-card {
  padding: 34rpx 32rpx;
}

.summary-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #202124;
  margin-bottom: 28rpx;
}

.summary-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.stat {
  background: #F7F1EA;
  border-radius: 16rpx;
  padding: 22rpx 8rpx;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #B85C38;
}

.stat-label {
  display: block;
  font-size: 26rpx;
  color: #7D756D;
  margin-top: 4rpx;
}

.calendar-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.calendar-head .section-title {
  margin-bottom: 0;
}

.legend {
  display: flex;
  gap: 14rpx;
  flex-shrink: 0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #7D756D;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  display: block;
}

.legend-dot.done {
  background: #2F7D51;
}

.legend-dot.missed {
  background: #C9B8A7;
}

.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid #ECE1D6;
  margin-bottom: 18rpx;
}

.weekday {
  text-align: center;
  font-size: 28rpx;
  color: #7D756D;
  font-weight: 800;
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.day-cell {
  min-height: 94rpx;
  border-radius: 16rpx;
  position: relative;
  padding: 10rpx 4rpx;
  background: #FFFCF8;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.day-cell.empty {
  background: transparent;
}

.day-num {
  font-size: 31rpx;
  color: #202124;
  font-weight: 800;
  line-height: 1.1;
}

.day-mark {
  min-height: 28rpx;
  margin-top: 6rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.day-cell.done {
  background: #EAF4ED;
  border-color: #B9D8C4;
}

.day-cell.done .day-num {
  color: #1F5E3A;
}

.day-cell.done .day-mark {
  color: #1F5E3A;
  background: #D8EBDD;
}

.day-cell.missed {
  background: #F1E8DD;
}

.day-cell.missed .day-num {
  color: #7D756D;
}

.day-cell.missed .day-mark {
  color: #6F6258;
  background: #E4D5C6;
}

.day-cell.today {
  border-color: #B85C38;
}

.today-mark {
  position: absolute;
  top: -8rpx;
  right: -6rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #B85C38;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 34rpx;
  text-align: center;
}

.today-card .btn-primary {
  margin-top: 26rpx;
}

.today-info {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.today-value {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #202124;
  line-height: 1.35;
}

.today-value.done {
  color: #1F5E3A;
}

.today-value.pending {
  color: #8F472B;
}

.today-badge {
  min-width: 88rpx;
  min-height: 52rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}

.today-badge.done {
  background: #EAF4ED;
  color: #1F5E3A;
}

.today-badge.pending {
  background: #F1E8DD;
  color: #8F472B;
}

.today-detail {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  font-size: 30rpx;
  color: #5F5A54;
  margin-top: 22rpx;
}

.history-list {
  border-top: 2rpx solid #ECE1D6;
}

.history-item {
  min-height: 104rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #ECE1D6;
}

.history-item:last-child {
  border-bottom: none;
}

.history-date {
  display: block;
  font-size: 32rpx;
  color: #202124;
  font-weight: 800;
}

.history-weekday {
  display: block;
  font-size: 26rpx;
  color: #7D756D;
  margin-top: 6rpx;
}

.history-right {
  text-align: right;
  flex-shrink: 0;
}

.history-status {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.history-status.done {
  color: #1F5E3A;
}

.history-status.missed {
  color: #7D756D;
}

.history-minutes {
  display: block;
  font-size: 26rpx;
  color: #7D756D;
  margin-top: 6rpx;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #7D756D;
  font-size: 32rpx;
}

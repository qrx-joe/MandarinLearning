/* 看板：统计清楚，少装饰 */

.dashboard-page {
  padding-top: 32rpx;
}

.family-header {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 34rpx 32rpx;
}

.family-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  background: #F1E8DD;
  border: 2rpx solid #D9CABA;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-icon {
  font-size: 40rpx;
  font-weight: 800;
  color: #8F472B;
}

.family-info {
  flex: 1;
  min-width: 0;
}

.family-name {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #202124;
  margin-bottom: 16rpx;
}

.family-stats {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.stat-badge {
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #F7F1EA;
  color: #5F5A54;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.alert-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #FFF6F2;
  border-color: #E7C5BC;
}

.alert-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #B33A2F;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 54rpx;
  text-align: center;
  flex-shrink: 0;
}

.alert-content {
  flex: 1;
  min-width: 0;
}

.alert-title {
  display: block;
  font-size: 31rpx;
  color: #B33A2F;
  font-weight: 800;
  line-height: 1.35;
}

.alert-desc {
  display: block;
  font-size: 27rpx;
  color: #7D756D;
  margin-top: 6rpx;
  line-height: 1.4;
}

.btn-remind {
  min-width: 128rpx;
  min-height: 70rpx;
  background: #B85C38;
  color: #FFFFFF;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  padding: 0 22rpx;
  margin: 0;
  line-height: 70rpx;
  flex-shrink: 0;
}

.btn-remind::after {
  border: none;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.section-sub {
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #F1E8DD;
  color: #8F472B;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 48rpx;
  flex-shrink: 0;
}

.week-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.week-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.week-label {
  font-size: 26rpx;
  color: #7D756D;
  font-weight: 800;
}

.week-dot {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  background: #F1E8DD;
  border: 2rpx solid #D9CABA;
  color: #8D837A;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 62rpx;
  text-align: center;
}

.week-dot.done {
  background: #EAF4ED;
  border-color: #B9D8C4;
  color: #1F5E3A;
}

.week-dot.today {
  border-color: #B85C38;
}

.record-list {
  border-top: 2rpx solid #ECE1D6;
}

.record-item {
  min-height: 104rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #ECE1D6;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  flex: 1;
  min-width: 0;
}

.record-date {
  display: block;
  font-size: 32rpx;
  color: #202124;
  font-weight: 800;
}

.record-segments {
  display: block;
  font-size: 26rpx;
  color: #7D756D;
  margin-top: 6rpx;
}

.record-minutes {
  color: #8F472B;
  font-size: 31rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.month-grid {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.month-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.month-label {
  width: 100rpx;
  color: #5F5A54;
  font-size: 28rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.month-bar-wrapper {
  flex: 1;
  height: 24rpx;
  background: #E9DED2;
  border-radius: 999rpx;
  overflow: hidden;
}

.month-bar {
  height: 100%;
  background: #B85C38;
  border-radius: 999rpx;
}

.month-count {
  width: 78rpx;
  text-align: right;
  color: #7D756D;
  font-size: 27rpx;
  font-weight: 800;
  flex-shrink: 0;
}

<view class="container">
  <!-- 已绑定家人 -->
  <view class="family-header" wx:if="{{boundUser}}">
    <view class="family-avatar">
      <text class="avatar-icon">👩</text>
    </view>
    <view class="family-info">
      <text class="family-name">{{boundUser.nickName || '妈妈'}}</text>
      <view class="family-stats">
        <text class="stat-badge">连续 {{boundUser.streakDays || 0}} 天</text>
        <text class="stat-badge">总 {{boundUser.totalDays || 0}} 天</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">👨‍👩‍👧</text>
    <text class="empty-title">还没有绑定家人</text>
    <text class="empty-desc">请在个人页打开"家庭监督"，获取绑定码</text>
  </view>

  <!-- 异常提醒 -->
  <view class="alert-card" wx:if="{{missedDays >= 2}}">
    <text class="alert-icon">⚠️</text>
    <view class="alert-content">
      <text class="alert-title">注意：已连续 {{missedDays}} 天未打卡</text>
      <text class="alert-desc">建议提醒家人坚持学习</text>
    </view>
    <button class="btn-remind" bindtap="sendReminder">提醒一下</button>
  </view>

  <!-- 本周打卡 -->
  <view class="section-card card" wx:if="{{boundUser}}">
    <view class="section-header">
      <text class="section-title">本周打卡</text>
      <text class="section-sub">{{weeklyCompleted}}/7 天</text>
    </view>
    <view class="week-grid">
      <view class="week-day" wx:for="{{weekDays}}" wx:key="date">
        <text class="week-label">{{item.label}}</text>
        <view class="week-dot {{item.completed ? 'done' : ''}} {{item.isToday ? 'today' : ''}}"></view>
      </view>
    </view>
  </view>

  <!-- 最近记录 -->
  <view class="section-card card" wx:if="{{recentRecords.length > 0}}">
    <view class="section-header">
      <text class="section-title">最近学习</text>
    </view>
    <view class="record-list">
      <view class="record-item" wx:for="{{recentRecords}}" wx:key="date">
        <view class="record-left">
          <text class="record-date">{{item.date}}</text>
          <text class="record-segments">完成了 {{item.segmentsCompleted || 0}} 个阶段</text>
        </view>
        <text class="record-minutes">{{item.minutes}}分钟</text>
      </view>
    </view>
  </view>

  <!-- 月度趋势（简化） -->
  <view class="section-card card" wx:if="{{monthlyStats.length > 0}}">
    <view class="section-header">
      <text class="section-title">月度统计</text>
    </view>
    <view class="month-grid">
      <view class="month-item" wx:for="{{monthlyStats}}" wx:key="month">
        <text class="month-label">{{item.month}}</text>
        <view class="month-bar-wrapper">
          <view class="month-bar" style="width: {{item.percentage}}%"></view>
        </view>
        <text class="month-count">{{item.completedDays}}天</text>
      </view>
    </view>
  </view>
</view>
.share-page {
  padding-top: 32rpx;
}

.preview-area {
  position: relative;
  padding: 30rpx 26rpx 34rpx;
}

.share-canvas {
  width: 690rpx;
  height: 920rpx;
  display: block;
  margin: 20rpx auto 0;
  border-radius: 22rpx;
  border: 2rpx solid #ECE1D6;
  box-shadow: 0 12rpx 30rpx rgba(89, 70, 51, 0.10);
  overflow: hidden;
}

.generating-overlay {
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  bottom: 34rpx;
  height: 920rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 252, 248, 0.92);
  border-radius: 22rpx;
}

.loading-spinner {
  width: 58rpx;
  height: 58rpx;
  border: 6rpx solid #E9DED2;
  border-top-color: #B85C38;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 18rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #5F5A54;
  font-weight: 800;
}

.action-buttons {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.btn-save,
.btn-share {
  flex: 1;
  min-height: 96rpx;
  border-radius: 48rpx;
  font-size: 31rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  padding: 0 16rpx;
}

.btn-save::after,
.btn-share::after {
  border: none;
}

.btn-save {
  background: #B85C38;
  color: #FFFFFF;
  box-shadow: 0 10rpx 22rpx rgba(184, 92, 56, 0.18);
}

.btn-share {
  background: #FFFCF8;
  color: #8F472B;
  border: 3rpx solid #B85C38;
}

.btn-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  font-size: 22rpx;
  line-height: 42rpx;
  text-align: center;
}

.btn-share .btn-icon {
  background: #F1E8DD;
}

.tip-text {
  text-align: center;
  font-size: 26rpx;
  color: #7D756D;
  line-height: 1.5;
}

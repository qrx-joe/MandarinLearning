/* 个人设置：克制、清楚、可反复使用 */

.profile-page {
  padding-top: 32rpx;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 34rpx 32rpx;
}

.user-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 30rpx;
  background: #F1E8DD;
  border: 2rpx solid #D9CABA;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 30rpx;
}

.avatar-text {
  font-size: 42rpx;
  color: #8F472B;
  font-weight: 800;
}

.avatar-badge {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  min-width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #B85C38;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-align: center;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.user-name {
  font-size: 42rpx;
  font-weight: 800;
  color: #202124;
  max-width: 330rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-icon {
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #F1E8DD;
  color: #8F472B;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.user-streak {
  display: block;
  font-size: 30rpx;
  color: #5F5A54;
}

.settings-list {
  padding: 30rpx 32rpx 8rpx;
}

.setting-item {
  min-height: 112rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #ECE1D6;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.setting-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #F7F1EA;
  border: 2rpx solid #E2D5C8;
  color: #8F472B;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  line-height: 58rpx;
  flex-shrink: 0;
}

.setting-icon.danger {
  color: #B33A2F;
  background: #F7E6E1;
  border-color: #E7C5BC;
}

.setting-info {
  flex: 1;
  min-width: 0;
}

.setting-title {
  display: block;
  font-size: 33rpx;
  color: #202124;
  font-weight: 800;
}

.setting-desc {
  display: block;
  font-size: 27rpx;
  color: #7D756D;
  margin-top: 6rpx;
  line-height: 1.35;
}

.picker-value {
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #F1E8DD;
  color: #8F472B;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.speed-setting {
  align-items: flex-start;
}

.speed-picker {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 22rpx;
  background: #F1E8DD;
  flex-shrink: 0;
}

.speed-option {
  min-width: 58rpx;
  min-height: 52rpx;
  border-radius: 18rpx;
  color: #5F5A54;
  font-size: 27rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.speed-option.active {
  background: #B85C38;
  color: #FFFFFF;
}

.arrow {
  font-size: 40rpx;
  color: #B8ADA2;
  flex-shrink: 0;
}

.danger .setting-title {
  color: #B33A2F;
}

.about-section {
  text-align: center;
  padding: 42rpx 28rpx 20rpx;
}

.about-text {
  display: block;
  font-size: 27rpx;
  color: #8D837A;
  line-height: 1.55;
}

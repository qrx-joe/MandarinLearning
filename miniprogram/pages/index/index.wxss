/* 首页 - 长辈友好风格 */

.welcome-card {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: #fff;
  border-radius: 28rpx;
  padding: 48rpx 36rpx;
}

.greeting {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}

.date {
  font-size: 30rpx;
  opacity: 0.85;
  display: block;
  margin-bottom: 20rpx;
}

.streak-row {
  display: flex;
  align-items: center;
}

.streak-text {
  font-size: 30rpx;
}

/* 今日任务 */
.task-card .task-header {
  margin-bottom: 24rpx;
}

.task-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
}

.task-desc {
  font-size: 32rpx;
  color: #666;
  line-height: 1.7;
  display: block;
  margin-bottom: 32rpx;
}

.progress-section {
  margin-bottom: 36rpx;
}

.progress-bar-bg {
  height: 24rpx;
  background: #F0E6E0;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.progress-bar-fill {
  height: 100%;
  background: #FF6B6B;
  border-radius: 12rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #999;
}

.start-btn {
  min-height: 108rpx;
  font-size: 36rpx;
  border-radius: 56rpx;
}

.btn-hint {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  display: block;
  margin-top: 16rpx;
}

/* 已完成 */
.done-card {
  text-align: center;
  padding: 60rpx 32rpx;
}

.done-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.done-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 12rpx;
}

.done-subtitle {
  font-size: 32rpx;
  color: #666;
  display: block;
  margin-bottom: 40rpx;
}

.done-stats {
  display: flex;
  justify-content: space-around;
  margin: 40rpx 0;
  padding: 36rpx 0;
  border-top: 2rpx solid #F0E6E0;
  border-bottom: 2rpx solid #F0E6E0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.stat-label {
  font-size: 28rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 本周主题 */
.theme-card .theme-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.theme-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.theme-week {
  font-size: 28rpx;
  color: #999;
}

.theme-name {
  font-size: 34rpx;
  color: #FF6B6B;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.theme-desc {
  font-size: 30rpx;
  color: #666;
  line-height: 1.6;
  display: block;
}

/* 快捷入口 */
.quick-grid {
  display: flex;
  justify-content: space-around;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 40rpx;
}

.quick-icon-bg {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #FFF5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-bottom: 16rpx;
}

.quick-label {
  font-size: 30rpx;
  color: #666;
}
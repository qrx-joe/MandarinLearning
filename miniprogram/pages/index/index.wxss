/* 首页：今日任务优先 */

.home-page {
  padding-top: 32rpx;
}

.today-panel {
  padding: 36rpx 32rpx 34rpx;
}

.today-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.streak-pill {
  min-height: 48rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #EAF4ED;
  color: #2F7D51;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.streak-pill.muted {
  background: #F1E8DD;
  color: #7D756D;
}

.greeting {
  display: block;
  font-size: 34rpx;
  line-height: 1.45;
  color: #5F5A54;
  margin-bottom: 28rpx;
}

.task-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #202124;
  line-height: 1.25;
  margin-bottom: 12rpx;
}

.task-desc {
  display: block;
  font-size: 32rpx;
  color: #4A4038;
  line-height: 1.65;
  margin-bottom: 28rpx;
}

.lesson-plan {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 30rpx;
}

.plan-step {
  min-height: 108rpx;
  border-radius: 18rpx;
  background: #F7F1EA;
  border: 2rpx solid #ECE1D6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.plan-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #B85C38;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  line-height: 40rpx;
  margin-bottom: 8rpx;
}

.plan-label {
  font-size: 28rpx;
  color: #4A4038;
  font-weight: 700;
}

.progress-section {
  margin-bottom: 30rpx;
}

.progress-section .progress-bar-bg {
  margin-bottom: 14rpx;
}

.progress-text {
  display: block;
  font-size: 28rpx;
  color: #7D756D;
}

.start-btn {
  font-size: 36rpx;
}

.done-card {
  text-align: left;
  padding: 36rpx 32rpx;
}

.done-status {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #EAF4ED;
  color: #2F7D51;
  font-size: 26rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
}

.done-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #202124;
  line-height: 1.35;
  margin-bottom: 10rpx;
}

.done-subtitle {
  display: block;
  font-size: 30rpx;
  color: #5F5A54;
  margin-bottom: 30rpx;
}

.done-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 30rpx;
}

.stat-item {
  background: #F7F1EA;
  border-radius: 16rpx;
  padding: 22rpx 8rpx;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 46rpx;
  font-weight: 800;
  color: #B85C38;
}

.stat-label {
  display: block;
  font-size: 26rpx;
  color: #7D756D;
  margin-top: 4rpx;
}

.theme-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.theme-header .section-title {
  margin-bottom: 0;
}

.theme-week {
  font-size: 28rpx;
  color: #7D756D;
}

.theme-name {
  display: block;
  font-size: 34rpx;
  color: #8F472B;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.theme-desc {
  display: block;
  font-size: 30rpx;
  color: #5F5A54;
  line-height: 1.65;
}

.quick-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.quick-item {
  min-height: 112rpx;
  border-radius: 18rpx;
  background: #F7F1EA;
  border: 2rpx solid #ECE1D6;
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.quick-mark {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #FFFCF8;
  border: 2rpx solid #D9CABA;
  color: #8F472B;
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
  line-height: 60rpx;
  margin-right: 20rpx;
}

.quick-copy {
  flex: 1;
}

.quick-label {
  display: block;
  font-size: 32rpx;
  color: #202124;
  font-weight: 800;
}

.quick-desc {
  display: block;
  font-size: 26rpx;
  color: #7D756D;
  margin-top: 6rpx;
}

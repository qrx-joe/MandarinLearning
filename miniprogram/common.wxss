/* 公共样式 */

page {
  background: #f8f8f8;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  padding-bottom: 40rpx;
}

.card {
  background: white;
  border-radius: 16rpx;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: white;
  color: #FF6B6B;
  border: 2rpx solid #FF6B6B;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
}

.btn-small {
  background: #FF6B6B;
  color: white;
  border-radius: 8rpx;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.text-primary {
  color: #FF6B6B;
}

.text-secondary {
  color: #666;
}

.text-muted {
  color: #999;
}

.text-center {
  text-align: center;
}

.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.gap-2 {
  gap: 20rpx;
}

.mt-2 {
  margin-top: 20rpx;
}

.mt-4 {
  margin-top: 40rpx;
}

.mb-2 {
  margin-bottom: 20rpx;
}

.p-3 {
  padding: 30rpx;
}
